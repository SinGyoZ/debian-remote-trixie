# debian-remote-trixie 环境配置示例
# 复制为 .env 后修改（cp .env.example .env）
# 密码永远不放这里 —— 密码只放 secrets/*.txt

# 时区
TZ=Asia/Shanghai

# 桌面用户名（小写字母开头，可用数字/_/-）
NEW_USER=singyo

# 是否加入 sudo 组（yes/留空）
NEW_USER_SUDO=yes

# 以下两项默认注释，需要时去掉注释：
# 锁定 root 账户（必须同时提供 NEW_USER，否则无人可登录）
#DIS_ROOT=yes
# 启用弱口令 guest 账户（guest:guest，仅建议隔离环境）
#GUEST_ACC=yes
